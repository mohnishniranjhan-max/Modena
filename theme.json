{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "name": "Modena Red",
          "slug": "modena-red",
          "color": "#b70100"
        },
        {
          "name": "Luxury Dark",
          "slug": "luxury-dark",
          "color": "#2a1613"
        },
        {
          "name": "Deep Charcoal",
          "slug": "deep-charcoal",
          "color": "#120706"
        },
        {
          "name": "Warm Ivory",
          "slug": "warm-ivory",
          "color": "#fdf6f0"
        },
        {
          "name": "Brand Blush",
          "slug": "brand-blush",
          "color": "#ffb4a8"
        },
        {
          "name": "Muted Pebble",
          "slug": "muted-pebble",
          "color": "#e8e1dc"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "Black",
          "slug": "black",
          "color": "#000000"
        }
      ],
      "gradients": [
        {
          "name": "Modena Hero",
          "slug": "modena-hero",
          "gradient": "linear-gradient(135deg, #120706 0%, #2a1613 60%, #b70100 100%)"
        },
        {
          "name": "Modena Subtle",
          "slug": "modena-subtle",
          "gradient": "linear-gradient(180deg, #fdf6f0 0%, #ffffff 100%)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "'Inter', system-ui, -apple-system, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400 900",
              "fontStyle": "normal",
              "src": ["https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"]
            }
          ]
        },
        {
          "name": "System Sans",
          "slug": "system-sans",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "name": "X-Small",   "slug": "xs",   "size": "0.75rem"  },
        { "name": "Small",     "slug": "sm",   "size": "0.875rem" },
        { "name": "Base",      "slug": "base", "size": "1rem"     },
        { "name": "Large",     "slug": "lg",   "size": "1.125rem" },
        { "name": "X-Large",   "slug": "xl",   "size": "1.25rem"  },
        { "name": "2X-Large",  "slug": "2xl",  "size": "1.5rem"   },
        { "name": "3X-Large",  "slug": "3xl",  "size": "1.875rem" },
        { "name": "4X-Large",  "slug": "4xl",  "size": "2.25rem"  },
        { "name": "5X-Large",  "slug": "5xl",  "size": "3rem"     },
        { "name": "Display",   "slug": "display", "size": "4rem"  }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "name": "1",   "slug": "1",  "size": "0.25rem" },
        { "name": "2",   "slug": "2",  "size": "0.5rem"  },
        { "name": "3",   "slug": "3",  "size": "0.75rem" },
        { "name": "4",   "slug": "4",  "size": "1rem"    },
        { "name": "5",   "slug": "5",  "size": "1.25rem" },
        { "name": "6",   "slug": "6",  "size": "1.5rem"  },
        { "name": "8",   "slug": "8",  "size": "2rem"    },
        { "name": "10",  "slug": "10", "size": "2.5rem"  },
        { "name": "12",  "slug": "12", "size": "3rem"    },
        { "name": "16",  "slug": "16", "size": "4rem"    },
        { "name": "20",  "slug": "20", "size": "5rem"    },
        { "name": "24",  "slug": "24", "size": "6rem"    }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "name": "Small",   "slug": "sm",  "shadow": "0 1px 2px rgba(0,0,0,.08)" },
        { "name": "Medium",  "slug": "md",  "shadow": "0 4px 16px rgba(0,0,0,.12)" },
        { "name": "Large",   "slug": "lg",  "shadow": "0 8px 32px rgba(0,0,0,.16)" },
        { "name": "Glow Red","slug": "glow-red","shadow": "0 0 32px rgba(183,1,0,.35)" }
      ]
    },
    "layout": {
      "contentSize": "960px",
      "wideSize": "1440px"
    },
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": true
  },
  "styles": {
    "color": {
      "background": "#fdf6f0",
      "text": "#2a1613"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--6)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--modena-red)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--luxury-dark)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "fontWeight": "800",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--modena-red)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--3)",
            "bottom": "var(--wp--preset--spacing--3)",
            "left": "var(--wp--preset--spacing--6)",
            "right": "var(--wp--preset--spacing--6)"
          }
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "single-product",
      "title": "Single Product",
      "postTypes": ["product"]
    },
    {
      "name": "archive-product",
      "title": "Product Archive",
      "postTypes": ["product"]
    },
    {
      "name": "page",
      "title": "Default Page",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Site Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site Footer",
      "area": "footer"
    }
  ]
}
