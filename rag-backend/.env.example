# =============================================================================
# MODENA RAG BACKEND & AUTH PIPELINE CONFIGURATION TEMPLATE
# =============================================================================
# Supply your server-side environment variables in .env (ignored by Git).
# =============================================================================

# JWT Authentication Secret Key (Required for signing user session tokens)
JWT_SECRET=

# SMTP Email Configuration (For transactional emails and OTP dispatch)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAILS_FROM_NAME=Modena Kitchenware
EMAILS_FROM_EMAIL=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SMS Gateway (Twilio / MSG91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
